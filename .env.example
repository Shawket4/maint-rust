DATABASE_URL=postgres://maint:secret@127.0.0.1:5432/apex_maint
REDIS_URL=redis://127.0.0.1:6379
JWT_SECRET=must_match_falcon_jwt_secret
FALCON_BASE_URL=https://apextransport.ddns.net/api/go
PORT=8090
RUST_LOG=info,maint_rust=debug

# Falcon proxy cache TTL in seconds (default 30)
FALCON_CARS_CACHE_TTL=30
FALCON_INVOICES_CACHE_TTL=30

# Optional: bind address. Default 127.0.0.1.
BIND_ADDR=127.0.0.1
