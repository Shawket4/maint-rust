DATABASE_URL=postgres://maint:secret@127.0.0.1:5432/apex_maint
REDIS_URL=redis://127.0.0.1:6379
JWT_SECRET=must_match_falcon_jwt_secret
FALCON_BASE_URL=https://apextransport.ddns.net/api/go
PORT=8090
RUST_LOG=info,maint_rust=debug

# Falcon proxy cache TTL in seconds (default 30)
FALCON_CARS_CACHE_TTL=30
FALCON_INVOICES_CACHE_TTL=30

# Optional: bind address. Default 127.0.0.1.
BIND_ADDR=127.0.0.1

# ── AI search (/ai/query) — optional; the endpoint 500s cleanly without it ──
# ANTHROPIC_API_KEY=sk-ant-...
# Claude model for AI search (default set in code)
# AI_MODEL=claude-haiku-4-5-20251001
# Direct read access to Falcon's Postgres for the AI run_sql tool.
# The server opens every AI query in a READ ONLY transaction, but grant a
# read-only role here anyway (defense in depth).
# FALCON_DATABASE_URL=postgres://readonly:...@127.0.0.1:5432/apex

# ── DEV ONLY — never set in production ──────────────────────────────────────
# Bypass Falcon credential check at /auth/login with a fixed local user:
# MAINT_DEV_LOGIN=1
# MAINT_DEV_USER_ID=1
